<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:myLocation="@string/system_ui_statusbar_battery_percent_title"
    app:quick_restart="com.android.systemui">
    <PreferenceCategory>
        <SwitchPreference
            android:defaultValue="false"
            android:key="prefs_key_system_ui_statusbar_battery_percent_enable"
            android:title="@string/system_ui_statusbar_battery_percent_enable" />
    </PreferenceCategory>

    <PreferenceCategory
        android:dependency="prefs_key_system_ui_statusbar_battery_percent_enable"
        android:title="@string/settings">
        <SwitchPreference
            android:defaultValue="false"
            android:key="prefs_key_system_ui_statusbar_battery_percent_at_right"
            android:title="@string/system_ui_statusbar_battery_percent_at_right" />
        <SwitchPreference
            android:defaultValue="true"
            android:key="prefs_key_system_ui_statusbar_battery_percent_show_sign"
            android:title="@string/system_ui_statusbar_battery_percent_show_sign" />
        <SwitchPreference
            android:defaultValue="true"
            android:key="prefs_key_system_ui_statusbar_battery_percent_charging_icon"
            android:title="@string/system_ui_statusbar_battery_percent_charging_icon" />
        <SwitchPreference
            android:defaultValue="true"
            android:key="prefs_key_system_ui_statusbar_battery_percent_low_warn"
            android:title="@string/system_ui_statusbar_battery_percent_low_warn" />
        <SeekBarPreferenceCompat
            android:key="prefs_key_system_ui_statusbar_battery_percent_font_size"
            android:title="@string/system_ui_statusbar_battery_percent_font_size"
            app:defaultValue="16"
            app:defaultValueTitle="@string/array_default"
            app:format="%.1f dp"
            app:maxValue="40"
            app:minValue="14"
            app:stepValue="1" />
    </PreferenceCategory>
</PreferenceScreen>
