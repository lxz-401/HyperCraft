<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:myLocation="@string/system_ui_volume_style_title"
    app:quick_restart="com.android.systemui">

    <com.sevtinge.hypercraft.prefs.LayoutPreference
        android:key="prefs_key_volume_style_preview"
        android:layout="@layout/layout_volume_style_preview"
        android:selectable="false" />

    <PreferenceCategory android:title="@string/volume_style_preset_category">
        <SwitchPreference
            android:defaultValue="false"
            android:key="prefs_key_system_ui_volume_oneui_style"
            android:summary="@string/volume_style_enable_desc"
            android:title="@string/volume_style_enable" />

        <fan.preference.DropDownPreference
            android:defaultValue="oneui"
            android:dependency="prefs_key_system_ui_volume_oneui_style"
            android:key="prefs_key_system_ui_volume_style_preset"
            android:summary="@string/volume_style_preset_desc"
            android:title="@string/volume_style_preset_title"
            app:entries="@array/volume_style_presets"
            app:entryValues="@array/volume_style_presets_values" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/volume_style_geometry_category">
        <SwitchPreference
            android:defaultValue="false"
            android:dependency="prefs_key_system_ui_volume_oneui_style"
            android:key="prefs_key_system_ui_volume_use_custom_geometry"
            android:summary="@string/volume_style_custom_geometry_desc"
            android:title="@string/volume_style_custom_geometry" />

        <SeekBarPreferenceCompat
            android:defaultValue="28"
            android:key="prefs_key_system_ui_volume_oneui_radius"
            android:title="@string/system_ui_volume_oneui_radius"
            app:note="@string/system_ui_volume_oneui_radius_desc"
            app:defaultValue="28"
            app:defaultValueTitle="@string/array_default"
            app:format="%s dp"
            app:maxValue="50"
            app:minValue="8"
            app:stepValue="1" />

        <SeekBarPreferenceCompat
            android:defaultValue="52"
            android:key="prefs_key_system_ui_volume_slider_width"
            android:title="@string/volume_style_slider_width"
            app:note="@string/volume_style_slider_width_desc"
            app:defaultValue="52"
            app:defaultValueTitle="@string/array_default"
            app:format="%s dp"
            app:maxValue="85"
            app:minValue="36"
            app:stepValue="1" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/volume_style_colors_category">
        <SwitchPreference
            android:defaultValue="false"
            android:dependency="prefs_key_system_ui_volume_oneui_style"
            android:key="prefs_key_system_ui_volume_oneui_custom_color"
            android:summary="@string/system_ui_volume_oneui_custom_color_desc"
            android:title="@string/system_ui_volume_oneui_custom_color" />

        <ColorPickerPreference
            android:defaultValue="-13338378"
            android:key="prefs_key_system_ui_volume_oneui_color"
            android:title="@string/system_ui_volume_oneui_color" />

        <SwitchPreference
            android:defaultValue="false"
            android:dependency="prefs_key_system_ui_volume_oneui_style"
            android:key="prefs_key_system_ui_volume_custom_bg"
            android:summary="@string/volume_style_custom_bg_desc"
            android:title="@string/volume_style_custom_bg" />

        <ColorPickerPreference
            android:defaultValue="855638016"
            android:key="prefs_key_system_ui_volume_bg_color"
            android:title="@string/volume_style_bg_color" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/volume_style_advanced_category">
        <SwitchPreference
            android:defaultValue="false"
            android:dependency="prefs_key_system_ui_volume_oneui_style"
            android:key="prefs_key_system_ui_volume_haptic"
            android:summary="@string/volume_style_haptic_desc"
            android:title="@string/volume_style_haptic_title" />
    </PreferenceCategory>
</PreferenceScreen>